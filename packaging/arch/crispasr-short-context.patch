diff --git i/tests/test-stream-finalize.cpp w/tests/test-stream-finalize.cpp
index 2503124..0ecd617 100755
--- i/tests/test-stream-finalize.cpp
+++ w/tests/test-stream-finalize.cpp
@@ -176,3 +176,80 @@ TEST_CASE("plan_partial_tail: stale anchor beyond the range decodes the full ran
     REQUIRE_FALSE(plan.commit);
     REQUIRE(plan.decode_start == 8000);
 }
+
+// --stream-short-context-sec: a sub-2-s final decoded again with the audio
+// before it. Positions are absolute samples at 16 kHz.
+using crispasr::keep_tokens_from;
+using crispasr::plan_short_context;
+
+namespace {
+constexpr int kSr = 16000;
+
+crispasr_token tok(const char* text, int64_t t0, int64_t t1) {
+    crispasr_token t;
+    t.text = text;
+    t.t0 = t0;
+    t.t1 = t1;
+    return t;
+}
+} // namespace
+
+TEST_CASE("plan_short_context: off, or no previous utterance, decodes nothing", "[unit][stream-json]") {
+    // Previous utterance 1-4 s, short one 5-5.6 s, window holds 0-6 s.
+    REQUIRE_FALSE(plan_short_context(0, 16000, 64000, 80000, 89600, 0, kSr).use);
+    REQUIRE_FALSE(plan_short_context(0, -1, -1, 80000, 89600, 10 * kSr, kSr).use);
+}
+
+TEST_CASE("plan_short_context: starts at the previous utterance, cuts mid-silence", "[unit][stream-json]") {
+    // Previous utterance 1-4.7 s, short one 5-5.6 s.
+    const auto plan = plan_short_context(0, 16000, 75200, 80000, 89600, 10 * kSr, kSr);
+    REQUIRE(plan.use);
+    REQUIRE(plan.start == 16000);
+    // Silence 4.7-5 s, middle 4.85 s, i.e. 3.85 s after the start of the decode.
+    REQUIRE(plan.cut_cs == 385);
+}
+
+TEST_CASE("plan_short_context: cuts at most 1 s before the utterance", "[unit][stream-json]") {
+    // Previous utterance 1-2 s, short one 5-5.6 s: a word the VAD missed in
+    // the 3 s gap must stay out, so the cut is 4 s, not the middle (3.5 s).
+    const auto plan = plan_short_context(0, 16000, 32000, 80000, 89600, 10 * kSr, kSr);
+    REQUIRE(plan.use);
+    REQUIRE(plan.cut_cs == 300);
+}
+
+TEST_CASE("plan_short_context: context is capped by N and by the rolling window", "[unit][stream-json]") {
+    // N = 2 s: start 3 s, inside the previous utterance.
+    REQUIRE(plan_short_context(0, 16000, 64000, 80000, 89600, 2 * kSr, kSr).start == 48000);
+    // Window rolled to 2 s: start there.
+    REQUIRE(plan_short_context(32000, 16000, 64000, 80000, 89600, 10 * kSr, kSr).start == 32000);
+}
+
+TEST_CASE("plan_short_context: previous speech gone from the window decodes nothing", "[unit][stream-json]") {
+    REQUIRE_FALSE(plan_short_context(70000, 16000, 64000, 80000, 89600, 10 * kSr, kSr).use);
+}
+
+TEST_CASE("plan_short_context: never hands the encoder less than the redecode minimum", "[unit][stream-json]") {
+    // Previous 4-4.4 s, short one 5-5.6 s: 1.6 s together, under 2 s.
+    REQUIRE_FALSE(plan_short_context(0, 64000, 70400, 80000, 89600, 10 * kSr, kSr).use);
+}
+
+TEST_CASE("keep_tokens_from: drops the context and its trailing punctuation", "[unit][stream-json]") {
+    crispasr_segment seg;
+    seg.text = " Bonjour à tous. Allô ?";
+    seg.tokens = {tok(" Bonjour", 0, 40), tok(" à", 40, 50),      tok(" tous", 50, 80),
+                  tok(".", 352, 353),     tok(" Allô", 360, 400), tok(" ?", 400, 410)};
+    const auto out = keep_tokens_from({seg}, 350);
+    REQUIRE(out.size() == 1);
+    REQUIRE(out[0].text == "Allô ?");
+    REQUIRE(out[0].tokens.size() == 3);
+    REQUIRE(out[0].t0 == 352);
+    REQUIRE(out[0].t1 == 410);
+}
+
+TEST_CASE("keep_tokens_from: without token timestamps there is nothing to cut on", "[unit][stream-json]") {
+    crispasr_segment seg;
+    seg.text = "Bonjour à tous. Allô ?";
+    REQUIRE(keep_tokens_from({seg}, 350).empty());
+    seg.tokens = {tok(" Bonjour", -1, -1)};
+    REQUIRE(keep_tokens_from({seg}, 350).empty());
+}
