index ad947f1..bd54909 100755
--- i/examples/cli/crispasr_stream_finalize.h
+++ w/examples/cli/crispasr_stream_finalize.h
@@ -10,9 +10,13 @@
 #pragma once
 
 #include "core/audio_chunking.h"
+#include "crispasr_backend.h"
 
 #include <algorithm>
+#include <cstdint>
+#include <cstring>
 #include <string>
+#include <vector>
 
 namespace crispasr {
 
@@ -115,4 +119,89 @@ inline PartialTailPlan plan_partial_tail(const float* window_pcm, int anchor, in
 // skipped and the caller falls back to `stitch_partial_accumulator`.
 constexpr int kStreamRedecodeMinSamples = 32000;
 
+// --stream-short-context-sec: give a short final the audio before it.
+//
+// An utterance under kStreamRedecodeMinSamples is never re-decoded, so its
+// final is the stitched partial of its VAD slice alone. Under a second of
+// speech is often too little for a multilingual model to settle on the
+// language ("Allô ?" comes back as "Hello?"). When the option is on, the
+// short utterance is decoded once more together with up to N s of the audio
+// in front of it, starting no earlier than the previous utterance, and only
+// the tokens after the middle of the silence between the two are kept, and
+// none from more than kShortContextLeadSamples before the utterance's VAD
+// start: speech the VAD missed in a long gap (a word under its minimum
+// duration) must not leak into the final. The lead is generous because a
+// transducer stamps the first word after a long silence early (Parakeet TDT:
+// up to ~0.4 s before the VAD start, measured).
+//
+// plan_short_context decides, in absolute samples, where that decode starts
+// and where its tokens are cut. It is not used when there is no previous
+// utterance, when the rolling window no longer holds any of its speech, or
+// when the combined range would still be under the encoder minimum.
+constexpr int kShortContextLeadSamples = 16000; // 1 s at 16 kHz
+
+struct ShortContextPlan {
+    bool use = false;
+    int64_t start = 0;  // absolute sample the context decode starts at
+    int64_t cut_cs = 0; // tokens before this (centiseconds from `start`) are context
+};
+
+inline ShortContextPlan plan_short_context(int64_t window_start, int64_t prev_start, int64_t prev_end,
+                                           int64_t utt_start, int64_t utt_end, int64_t max_context, int sample_rate) {
+    ShortContextPlan plan;
+    if (max_context <= 0 || prev_start < 0)
+        return plan;
+    const int64_t start = std::max({window_start, prev_start, utt_start - max_context});
+    if (start >= prev_end || utt_end - start < kStreamRedecodeMinSamples)
+        return plan;
+    const int64_t boundary = std::max((prev_end + utt_start) / 2, utt_start - kShortContextLeadSamples);
+    plan.use = true;
+    plan.start = start;
+    plan.cut_cs = (boundary - start) * 100 / sample_rate;
+    return plan;
+}
+
+// Drop the context from a short-context decode: keep the tokens that start at
+// or after `cut_cs` and rebuild each segment's text from them. Returns an
+// empty vector when the backend gave no token timestamps (nothing to cut on),
+// so the caller falls back to the stitched partial as before.
+inline std::vector<crispasr_segment> keep_tokens_from(const std::vector<crispasr_segment>& segs, int64_t cut_cs) {
+    std::vector<crispasr_segment> out;
+    for (const auto& seg : segs) {
+        if (seg.tokens.empty() && !seg.text.empty())
+            return {};
+        crispasr_segment kept;
+        kept.speaker = seg.speaker;
+        kept.lang_id = seg.lang_id;
+        for (const auto& tok : seg.tokens) {
+            if (tok.is_special)
+                continue;
+            if (tok.t0 < 0)
+                return {};
+            if (tok.t0 < cut_cs)
+                continue;
+            if (kept.tokens.empty())
+                kept.t0 = tok.t0;
+            kept.t1 = std::max(tok.t0, tok.t1);
+            kept.text += tok.text;
+            kept.tokens.push_back(tok);
+        }
+        for (const auto& w : seg.words)
+            if (w.t0 >= cut_cs)
+                kept.words.push_back(w);
+        if (!kept.tokens.empty())
+            out.push_back(std::move(kept));
+    }
+    // A punctuation token closing the context phrase can be stamped just past
+    // the cut; a phrase never starts with one, nor with a space.
+    if (!out.empty()) {
+        std::string& t = out.front().text;
+        size_t k = 0;
+        while (k < t.size() && std::strchr(" .,;:?!", t[k]))
+            k++;
+        t.erase(0, k);
+    }
+    return out;
+}
+
 } // namespace crispasr
