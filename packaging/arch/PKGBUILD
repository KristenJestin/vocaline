# Builds the checkout this file sits in, not a download of it: CI and a local `makepkg` package
# exactly the commit they stand on.

pkgname=vocaline
pkgver=0.0.0
pkgrel=1
pkgdesc='Local dictation: the phrase shows while you speak, and is pasted when you stop'
arch=(x86_64)
url='https://github.com/KristenJestin/vocaline'
# Vocaline is AGPL-3.0-only; the CrispASR it bundles, with its ggml, is MIT.
license=(AGPL-3.0-only MIT)
depends=(
  gcc-libs glibc
  libgomp   # CrispASR's threads
  openblas  # CrispASR's mel filterbank
  curl      # vocaline setup
  pipewire  # pw-record
  wtype     # the paste shortcut
)
optdepends=(
  'cuda: the cuda backend, on an NVIDIA GPU'
  'hyprland: pasting where the dictation started'
)
makedepends=(cargo git cmake ninja cuda)
options=(!debug)

# The engine is CrispASR built from its source at a release, with Vocaline's patch
# (crispasr-short-context.patch: --stream-short-context-sec). Its ggml and c2pa-audio are
# submodules, and its tests fetch Catch2 at configure time: all are sources here, so the build
# needs no network.
_crispasr=0.8.42
_ggml=c36dab89b662838f0f5d4826c399198c0b90bbfc
_c2pa_audio=e40329b83f16f67bb5ddc7bb13ae18de0a9376fc
_catch2=3.7.1
source=("crispasr::git+https://github.com/CrispStrobe/CrispASR.git#tag=v$_crispasr"
        "ggml::git+https://github.com/CrispStrobe/ggml.git#commit=$_ggml"
        "c2pa-audio::git+https://github.com/CrispStrobe/c2pa-audio.git#commit=$_c2pa_audio"
        "catch2::git+https://github.com/catchorg/Catch2.git#tag=v$_catch2"
        crispasr-short-context.patch)
sha256sums=('8891fd0a2130082e591ffb02d180630341b4bc140ac7fb7819e12abee12d9b02'
            'd55bb0a99001dd675428907deb77193741a461da1fdfff21bc801ddb963995c2'
            'c17e5033b8d476651b69bd7193eb9371876cf4375759789c153119298c503532'
            '63ff271325220bc5df168fd1efe694c80678dddac2889dd5603219b4383c3cbe'
            '6c048d9de53f4e11511e523f9fc17e533c16699e067651631e33d164c9656003')

_root=$(realpath "$startdir/../..")

# On a tag vX.Y.Z: X.Y.Z, which must be the version of Cargo.toml. Elsewhere, the usual scheme
# of a VCS package, X.Y.Z.rN.gHASH: N commits after the last release tag (0.0.0 before the
# first), so pacman orders a dev build after the release it follows and before the next one.
pkgver() {
  cd "$_root"
  local described tag count
  if described=$(git describe --long --tags --abbrev=7 --match 'v[0-9]*' 2>/dev/null); then
    tag=${described%-*-g*}
    count=${described#"$tag"-}
    count=${count%%-*}
  else
    tag=v0.0.0
    count=$(git rev-list --count HEAD)
  fi
  if [[ $count == 0 && $tag != v0.0.0 ]]; then
    local cargo
    cargo=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)
    if [[ ${tag#v} != "$cargo" ]]; then
      error "tag %s does not match the version of Cargo.toml (%s)" "$tag" "$cargo"
      return 1
    fi
    printf '%s' "${tag#v}"
  else
    printf '%s.r%s.g%s' "${tag#v}" "$count" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$srcdir/crispasr"
  local module
  for module in ggml third_party/c2pa-audio; do
    git submodule init "$module"
    git config "submodule.$module.url" "$srcdir/${module##*/}"
    git -c protocol.file.allow=always submodule update "$module"
  done
  patch -Np1 -i "$srcdir/crispasr-short-context.patch"

  cargo fetch --locked --manifest-path "$_root/Cargo.toml" --target "$(rustc -vV | sed -n 's/^host: //p')"
}

_build_crispasr() {
  # The prebuilt CUDA 13 bundle's setup: the ggml backends are loaded at run time, so the same
  # binary runs on the CPU where CUDA is missing, with a CPU variant per generation (x64 to
  # Sapphire Rapids and Zen 4). CUDA from Turing (sm_75) to Blackwell (sm_120), plus PTX for
  # what comes after. Every library is built into bin/ and found beside crispasr, wherever it
  # is installed (the tests' Catch2 too, so they run from there).
  cmake -S "$srcdir/crispasr" -B "$srcdir/crispasr-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON \
    -DGGML_BACKEND_DL=ON \
    -DGGML_NATIVE=OFF \
    -DGGML_CPU_ALL_VARIANTS=ON \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_COMPILER=/opt/cuda/bin/nvcc \
    -DCMAKE_CUDA_HOST_COMPILER="$(sed -n "s/^export NVCC_CCBIN='\(.*\)'$/\1/p" /etc/profile.d/cuda.sh)" \
    -DCMAKE_CUDA_ARCHITECTURES='75-real;80-real;86-real;89-real;90-real;90-virtual;120a-real;120-virtual' \
    -DCMAKE_LIBRARY_OUTPUT_DIRECTORY="$srcdir/crispasr-build/bin" \
    -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
    -DCMAKE_INSTALL_RPATH='$ORIGIN' \
    -DCRISPASR_BUILD_EXAMPLES=ON \
    -DCRISPASR_BUILD_SERVER=OFF \
    -DCRISPASR_BUILD_TESTS=ON \
    -DCRISPASR_OPUS=OFF \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DFETCHCONTENT_SOURCE_DIR_CATCH2="$srcdir/catch2"
  cmake --build "$srcdir/crispasr-build" --target crispasr-cli test-stream-finalize
}

build() {
  # Compiling CrispASR's CUDA kernels takes hours: CI keeps the bin/ it built, keyed on what
  # it is built from (.github/workflows/package.yml), and hands it back here when none of that
  # changed. A local makepkg always builds it.
  if [[ -n ${VOCALINE_CRISPASR_BUILT:-} ]]; then
    mkdir -p "$srcdir/crispasr-build"
    cp -a "$VOCALINE_CRISPASR_BUILT" "$srcdir/crispasr-build/bin"
  else
    _build_crispasr
  fi

  export CARGO_TARGET_DIR="$srcdir/target"
  export VOCALINE_ENGINE=/usr/lib/vocaline/crispasr/crispasr
  export VOCALINE_VERSION=$pkgver
  cargo build --release --frozen --manifest-path "$_root/Cargo.toml"
}

check() {
  "$srcdir/crispasr-build/bin/test-stream-finalize"

  export CARGO_TARGET_DIR="$srcdir/target"
  export VOCALINE_ENGINE=/usr/lib/vocaline/crispasr/crispasr
  export VOCALINE_VERSION=$pkgver
  cargo test --release --frozen --manifest-path "$_root/Cargo.toml"
}

package() {
  install -Dm755 "$srcdir/target/release/vocaline" "$pkgdir/usr/bin/vocaline"
  install -Dm644 "$_root/packaging/vocaline.service" "$pkgdir/usr/lib/systemd/user/vocaline.service"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$_root/LICENSE" "$_root/NOTICE"
  install -Dm644 -t "$pkgdir/usr/share/doc/vocaline" "$_root/README.md" "$_root/docs/events.md"

  # The engine keeps the layout of the prebuilt bundle: crispasr finds its libraries beside itself.
  local engine="$pkgdir/usr/lib/vocaline/crispasr"
  install -Dm755 -t "$engine" "$srcdir/crispasr-build/bin/crispasr"
  cp -P "$srcdir/crispasr-build/bin"/{libcrispasr,libggml,libggml-base}.so.* \
    "$srcdir/crispasr-build/bin"/libggml-{cpu-*,cuda}.so "$engine/"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/crispasr" \
    "$srcdir/crispasr"/{LICENSE,THIRD_PARTY_NOTICES.txt} "$srcdir/crispasr-short-context.patch"
}
